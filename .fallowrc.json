{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/*.mjs",
    "proof/*/smoke.ts",
    "proof/*/*.mjs",
    "packages/runtime/src/bin/*.ts",
    "packages/microvm/test-fixtures/assets/*.{js,ts,mjs}",
    "examples/**/rootfs/**/*.{js,mjs,ts}",
    "examples/firecracker-nested/run.ts",
    "examples/live-mount/shared/server.mjs",
    "examples/quickstart/counter.mjs",
    "packages/cli/src/portable-restore-adapter.ts",
    "packages/microvm/test-fixtures/proof-assets/*.mjs",
    "scripts/fixtures/node-ecosystem-registry/packages/*/src/*.cjs"
  ],
  "duplicates": {
    "ignore": [
      "**/__tests__/**",
      "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
      "proof/**",
      "scripts/native-dwarf-pointer-classification.ts",
      "scripts/*-proof.mjs",
      "scripts/*-smoke.mjs",
      "scripts/hard-runtime-refusal-contract.mjs",
      "packages/microvm/test-fixtures/proof-assets/*.mjs",
      "packages/cli/src/commands/move.ts",
      "packages/cli/src/move-*-envelope.ts",
      "packages/cli/src/move-envelope-capture.ts",
      "packages/cli/src/move-envelope-loader-commands.ts",
      "packages/cli/src/move-file-utility-*.ts",
      "packages/cli/src/move-filesystem-mutation-envelope.ts",
      "packages/cli/src/move-native-bundle.ts",
      "packages/cli/src/move-rendezvous.ts",
      "packages/cli/src/move-resource-plan.ts",
      "packages/runtime/src/move-pid-graph.ts"
    ]
  },
  "health": {
    "ignore": [
      "**/__tests__/**",
      "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
      "proof/**",
      "scripts/native-dwarf-pointer-classification.ts",
      "scripts/*-proof.mjs",
      "scripts/*-smoke.mjs",
      "scripts/hard-runtime-refusal-contract.mjs",
      "packages/cli/src/commands/move.ts",
      "packages/cli/src/move-*-envelope.ts",
      "packages/cli/src/move-envelope-capture.ts",
      "packages/cli/src/move-envelope-loader-commands.ts",
      "packages/cli/src/move-file-utility-*.ts",
      "packages/cli/src/move-filesystem-mutation-envelope.ts",
      "packages/cli/src/move-native-bundle.ts",
      "packages/cli/src/move-rendezvous.ts",
      "packages/cli/src/move-resource-plan.ts",
      "packages/runtime/src/move-pid-graph.ts"
    ]
  },
  "ignoreDependencies": [
    "@homebridge/node-pty-prebuilt-multiarch",
    "@nkzw/oxlint-config",
    "@redwoodjs/agent-ci",
    "typedoc-plugin-markdown",
    "audited-conditional-exports",
    "audited-dual-package",
    "audited-native-prebuild",
    "audited-optional-consumer",
    "audited-optional-missing",
    "audited-optional-present",
    "audited-peer-consumer",
    "audited-peer-provider",
    "audited-transitive-a",
    "audited-transitive-b"
  ],
  "dynamicallyLoaded": ["packages/microvm/test-fixtures/proof-assets/*.mjs"]
}
