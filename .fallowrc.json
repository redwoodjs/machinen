{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/*.mjs",
    "packages/runtime/src/bin/*.ts",
    "packages/microvm/test-fixtures/assets/*.{js,ts,mjs}",
    "examples/**/rootfs/**/*.{js,mjs,ts}",
    "examples/firecracker-nested/run.ts",
    "examples/live-mount/shared/server.mjs",
    "examples/quickstart/counter.mjs"
  ],
  "duplicates": {
    "ignore": [
      "**/__tests__/**",
      "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
      "packages/runtime/src/runtime-adapter.ts"
    ]
  },
  "health": {
    "ignore": ["**/__tests__/**", "**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}"]
  },
  "ignoreDependencies": [
    "@homebridge/node-pty-prebuilt-multiarch",
    "@nkzw/oxlint-config",
    "@redwoodjs/agent-ci",
    "typedoc-plugin-markdown"
  ],
  "audit": {
    "healthBaseline": "fallow-baselines/audit-health.json",
    "dupesBaseline": "fallow-baselines/audit-dupes.json"
  }
}
