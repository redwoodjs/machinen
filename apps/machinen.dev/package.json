{
  "name": "@machinen/marketing-website",
  "version": "1.0.0",
  "private": true,
  "description": "The machinen.dev marketing website.",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prebuild": "pnpm recipes:verify",
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "pnpm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && pnpm run clean && pnpm run build && wrangler deploy",
    "recipes:sign": "node scripts/run-recipes.mjs",
    "recipes:verify": "node scripts/run-recipes.mjs --verify",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "pnpm run generate && pnpm run types",
    "typecheck": "tsc --noEmit",
    "types": "tsc"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-server-dom-webpack": "19.2.8",
    "rwsdk": "1.2.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.33.2",
    "@cloudflare/workers-types": "4.20260426.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "~25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "~8.0.16",
    "wrangler": "4.85.0"
  }
}
