{
  "schemaVersion": 1,
  "publisher": "machinen.dev",
  "name": "codex",
  "summary": "Run Codex inside a VM.",
  "install": "fnm install 24.16.0\nfnm default 24.16.0\nnpm install -g @openai/codex@0.144.4\ncodex --version",
  "command": ["codex"],
  "env": {
    "CODEX_HOME": "/root/.codex"
  },
  "permissions": {
    "network": true,
    "workspace": "rw",
    "state": [
      {
        "name": "config",
        "guest": "/root/.codex",
        "mode": "rw"
      }
    ]
  }
}
