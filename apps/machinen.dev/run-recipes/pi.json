{
  "schemaVersion": 1,
  "publisher": "machinen.dev",
  "name": "pi",
  "summary": "Run the pi coding agent inside a VM.",
  "install": [
    "set -e",
    "apt-get update",
    "apt-get install -y --no-install-recommends git ca-certificates openssh-client",
    "rm -rf /var/lib/apt/lists/*",
    "fnm install 24.16.0",
    "fnm default 24.16.0",
    "npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.80.7",
    "git --version",
    "pi --version"
  ],
  "command": ["pi"],
  "permissions": {
    "network": true,
    "workspace": "rw",
    "state": [
      {
        "name": "agent",
        "guest": "/root/.pi/agent",
        "mode": "rw"
      }
    ]
  }
}
