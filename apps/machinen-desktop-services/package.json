{
  "name": "@machinen/desktop-services",
  "version": "0.1.0",
  "private": true,
  "description": "Built-in TypeScript services for Machinen Desktop.",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --root ../.. apps/machinen-desktop-services/src"
  },
  "dependencies": {
    "@machinen/desktop-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.3.5",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
