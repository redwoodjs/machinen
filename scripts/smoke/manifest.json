{
  "kind": "machinen.smoke-suite-manifest",
  "formatVersion": 1,
  "policy": {
    "productSmoke": "Active smoke package scripts cover product/release behavior only.",
    "noProofPackageScripts": "Proof and research harnesses are not package scripts.",
    "proofArtifacts": "Proof-only harnesses are removed from the smoke surface and must not be cited as product support."
  },
  "entries": [
    {
      "path": "scripts/smoke-test-snapshot-restore-fork.sh",
      "classification": "product-smoke",
      "packageScripts": ["smoke-test-snapshot-restore-fork"],
      "reason": "end-to-end CRIU/vmstate snapshot, restore, fork, lazy restore, and live-mount composition coverage",
      "requires": ["local-hvf-or-kvm", "release-assets"]
    },
    {
      "path": "scripts/smoke-tests.sh",
      "classification": "product-smoke",
      "packageScripts": ["smoke-tests"],
      "reason": "core local VM CLI boot, mount, live-mount, memory, balloon, and rootfs contract coverage",
      "requires": ["local-hvf-or-kvm", "release-assets"]
    },
    {
      "path": "scripts/smoke/vmstate/all.sh",
      "classification": "product-smoke",
      "packageScripts": ["smoke-vmstate"],
      "reason": "aggregate for focused whole-VM vmstate regressions",
      "requires": ["local-hvf-or-kvm", "release-assets"]
    },
    {
      "path": "scripts/smoke/vmstate/common.sh",
      "classification": "helper",
      "packageScripts": [],
      "reason": "shared harness sourced by vmstate smoke tests",
      "requires": []
    },
    {
      "path": "scripts/smoke/vmstate/entropy.sh",
      "classification": "product-smoke",
      "packageScripts": ["smoke-vmstate-entropy"],
      "reason": "whole-VM vmstate entropy reseed regressions",
      "requires": ["local-hvf-or-kvm", "release-assets"]
    },
    {
      "path": "scripts/smoke/vmstate/sockets.sh",
      "classification": "product-smoke",
      "packageScripts": ["smoke-vmstate-sockets"],
      "reason": "whole-VM vmstate socket and port-forward regressions",
      "requires": ["local-hvf-or-kvm", "release-assets"]
    },
    {
      "path": "scripts/smoke/vmstate/timers.sh",
      "classification": "product-smoke",
      "packageScripts": ["smoke-vmstate-timers"],
      "reason": "whole-VM vmstate timer and clock regressions",
      "requires": ["local-hvf-or-kvm", "release-assets"]
    }
  ]
}
