{
  "kind": "machinen.level4-ping-target-vm-continuation",
  "goal": "013",
  "profile": {
    "name": "ping-level4-socket-reconstruction-v1",
    "evidenceStatus": "support",
    "productSupport": "supported",
    "implementationLevel": "level-4-kernel-resource-reconstruction",
    "graduationTargetLevel": "level-4-kernel-resource-reconstruction",
    "productClaim": "portable ping restore boots a target VM and starts target-native ping continuation"
  },
  "bundleIntent": {
    "destination": "127.0.0.1",
    "socketKinds": ["ping-dgram-icmp", "raw-icmp"],
    "carriesEchoIdentifier": true,
    "carriesNextSequence": true,
    "carriesInterval": true,
    "outputLogPath": "/tmp/machinen-restored-ping.log",
    "targetArchRequired": true
  },
  "restoreBehavior": {
    "bootsTargetVm": true,
    "startsTargetNativePing": true,
    "targetBinary": "/usr/bin/ping",
    "jsonReturnsRestoredNameAndPid": true,
    "migrationCompleted": true,
    "targetOutputObserved": true
  },
  "honestSemantics": {
    "destinationPreserved": true,
    "intervalPreserved": true,
    "descriptorEchoIdAndSequencePreserved": true,
    "standardPingMayRenumberTextSequence": true,
    "stricterFutureHelperNeededForExactForcedIcmpIdSequence": true
  },
  "userVerifier": "machinen exec <restored-name> -- cat /tmp/machinen-restored-ping.log",
  "expectedOutputFragment": "64 bytes from 127.0.0.1",
  "stableRefusals": [
    "zero-or-multiple-ping-processes",
    "non-loopback-destination",
    "non-empty-queue",
    "active-receive-wait",
    "unmatched-socket-inode",
    "target-architecture-mismatch",
    "target-verifier-mismatch"
  ]
}
