{
  "kind": "machinen.level4-ping-auto-inspection",
  "goal": "012",
  "profile": {
    "name": "ping-level4-socket-reconstruction-v1",
    "evidenceStatus": "support",
    "productSupport": "supported",
    "implementationLevel": "level-4-kernel-resource-reconstruction",
    "graduationTargetLevel": "level-4-kernel-resource-reconstruction",
    "productClaim": "portable machine snapshot auto-inspects a running loopback ping workload and emits the Level 4 ping socket descriptor"
  },
  "publicFlow": [
    "machinen boot --detach --name <name> -- sleep 1000",
    "machinen exec <name> -- 'ping -i 10 127.0.0.1 >/tmp/ping.log 2>&1 &'",
    "MACHINEN_SNAPSHOT_ENGINE=portable machinen snapshot <name> <bundle>",
    "machinen restore <bundle> --target-arch <arch> [--target-verifier-output <file>]"
  ],
  "autoInspection": {
    "manualDescriptorRequired": false,
    "sourceInspection": [
      "/proc/<pid>/comm",
      "/proc/<pid>/cmdline",
      "/proc/<pid>/fd/*",
      "/proc/<pid>/wchan",
      "/proc/net/icmp",
      "/proc/net/raw"
    ],
    "acceptedBoundary": [
      "exactly one running ping process",
      "loopback destination",
      "empty ping/raw socket queues",
      "no active receive wait",
      "socket inode matches /proc/net/icmp or /proc/net/raw"
    ]
  },
  "stableRefusals": [
    "zero-or-multiple-ping-processes",
    "non-loopback-destination",
    "non-empty-queue",
    "active-receive-wait",
    "unmatched-socket-inode",
    "non-ping-workload"
  ],
  "validation": {
    "smoke": "pnpm run smoke-portable-ping-machine",
    "runtimeTests": "packages/runtime/src/__tests__/portable-snapshot.test.ts",
    "productRegistry": "ping-level4-socket-reconstruction-v1 remains implemented Level 4 support; ping-sequence-counter-semantic-continuation-v1 remains retired from product support"
  }
}
