{
  "kind": "machinen.portable-vm-manifest-plan",
  "version": 1,
  "status": "draft-for-validation",
  "scope": "cross-architecture-portable-whole-vm-restore-v1",
  "purpose": "Describe a paused VM as portable inventory plus a restore/refusal plan before any cross-architecture whole-VM restore claim is made.",
  "claimGuard": {
    "publicClaimAllowed": false,
    "arbitraryVmRestoreClaimed": false,
    "arbitraryLinuxProcessRestoreClaimed": false,
    "rawVmStateReplayAllowed": false,
    "crossIsaVcpuReplayAllowed": false,
    "sourceIsaEmulationAllowed": false,
    "metadataOnlySuccessAllowed": false
  },
  "sourceVm": {
    "id": "example-source-vm",
    "sourceArchitecture": "arm64",
    "targetArchitecture": "amd64",
    "guestOs": "linux",
    "kernel": "example-kernel-version",
    "vmm": "machinen-vm",
    "pauseMode": "guest-quiesced",
    "quiesce": {
      "filesystemFrozen": true,
      "servicesStoppedOrCheckpointed": "selected-services-only",
      "databasesClean": "selected-clean-databases-only",
      "networkDrained": "listeners-only-active-streams-refused"
    }
  },
  "targetPolicy": {
    "restoreMode": "target-native-reconstruction",
    "allowedTargetArchitectures": ["arm64", "amd64"],
    "dependencyPolicy": "target-native-dependencies-required",
    "unknownStatePolicy": "refuse-by-default"
  },
  "dispositionLegend": [
    {
      "disposition": "portable",
      "meaning": "Can be copied or materialized without architecture-specific interpretation."
    },
    {
      "disposition": "reconstructable",
      "meaning": "Can be recreated target-native from portable metadata."
    },
    {
      "disposition": "product-supported",
      "meaning": "A retained product path exists for this row and scope."
    },
    {
      "disposition": "refused",
      "meaning": "Known unsafe or unsupported; restore must stop with a stable refusal code."
    },
    {
      "disposition": "same-arch-only",
      "meaning": "May be restorable only without crossing CPU architecture."
    },
    {
      "disposition": "unknown",
      "meaning": "Not classified; refused by default."
    }
  ],
  "manifest": {
    "filesystems": [
      {
        "id": "rootfs-file-tree",
        "mountPoint": "/",
        "state": "clean-file-tree",
        "contentAddressed": true,
        "disposition": "portable"
      }
    ],
    "services": [
      {
        "id": "example-c-service",
        "manager": "systemd-or-supervisor",
        "binaryPolicy": "target-native-binary-required",
        "disposition": "product-supported"
      }
    ],
    "processes": [
      {
        "id": "selected-service-process",
        "argvCaptured": true,
        "envCaptured": true,
        "cwdCaptured": true,
        "memoryPolicy": "portable-data-only",
        "disposition": "reconstructable"
      },
      {
        "id": "unknown-live-process",
        "state": "unclassified-live-process-state",
        "disposition": "refused",
        "refusalCode": "portable-vm-unknown-process-state-unsupported"
      }
    ],
    "network": [
      {
        "id": "http-listener-8080",
        "protocol": "tcp",
        "state": "listening-no-active-streams",
        "disposition": "reconstructable"
      },
      {
        "id": "active-tcp-streams",
        "state": "connected-streams-or-in-flight-packets",
        "disposition": "refused",
        "refusalCode": "portable-vm-active-network-stream-unsupported"
      }
    ],
    "databases": [
      {
        "id": "sqlite-clean-db",
        "engine": "sqlite",
        "state": "clean-quiesced",
        "disposition": "product-supported"
      },
      {
        "id": "postgres-dirty-wal",
        "engine": "postgresql",
        "state": "active-transaction-or-dirty-wal",
        "disposition": "refused",
        "refusalCode": "portable-vm-active-db-state-unsupported"
      }
    ],
    "devices": [
      {
        "id": "virtio-net",
        "state": "configuration-only",
        "disposition": "reconstructable"
      },
      {
        "id": "passthrough-gpu",
        "state": "opaque-device-state",
        "disposition": "refused",
        "refusalCode": "portable-vm-opaque-device-state-unsupported"
      }
    ],
    "kernelState": [
      {
        "id": "mount-namespace",
        "state": "declared-mount-table",
        "disposition": "reconstructable"
      },
      {
        "id": "active-syscalls",
        "state": "in-kernel-continuation",
        "disposition": "refused",
        "refusalCode": "portable-vm-active-syscall-unsupported"
      }
    ]
  },
  "plan": {
    "rows": [
      {
        "id": "vm/rootfs-file-tree",
        "component": "filesystem",
        "sourceRef": "rootfs-file-tree",
        "disposition": "portable",
        "restoreStrategy": "copy-content-addressed-file-tree",
        "artifactRequirements": ["file-tree-manifest", "content-hashes"],
        "proofGate": "file-tree-materialization-proof"
      },
      {
        "id": "vm/example-c-service",
        "component": "service",
        "sourceRef": "example-c-service",
        "disposition": "product-supported",
        "restoreStrategy": "install-target-native-binary-and-start-service",
        "artifactRequirements": ["service-manifest", "target-native-binary", "start-verifier"],
        "proofGate": "service-product-gate"
      },
      {
        "id": "vm/http-listener-8080",
        "component": "network",
        "sourceRef": "http-listener-8080",
        "disposition": "reconstructable",
        "restoreStrategy": "bind-target-native-listener",
        "artifactRequirements": ["listener-manifest", "port-policy", "request-response-verifier"],
        "proofGate": "network-listener-reconstruction-proof"
      },
      {
        "id": "vm/sqlite-clean-db",
        "component": "database",
        "sourceRef": "sqlite-clean-db",
        "disposition": "product-supported",
        "restoreStrategy": "restore-clean-db-with-target-native-tooling",
        "artifactRequirements": [
          "clean-db-export-or-snapshot",
          "target-native-sqlite-tooling",
          "query-verifier"
        ],
        "proofGate": "clean-db-product-gate"
      },
      {
        "id": "vm/postgres-dirty-wal",
        "component": "database",
        "sourceRef": "postgres-dirty-wal",
        "disposition": "refused",
        "restoreStrategy": "stop-before-restore",
        "refusalCode": "portable-vm-active-db-state-unsupported",
        "artifactRequirements": ["dirty-wal-detector-transcript", "stable-refusal-code"],
        "proofGate": "dirty-db-refusal-proof"
      },
      {
        "id": "vm/active-tcp-streams",
        "component": "network",
        "sourceRef": "active-tcp-streams",
        "disposition": "refused",
        "restoreStrategy": "stop-before-restore",
        "refusalCode": "portable-vm-active-network-stream-unsupported",
        "artifactRequirements": ["active-stream-detector-transcript", "stable-refusal-code"],
        "proofGate": "active-network-refusal-proof"
      },
      {
        "id": "vm/passthrough-gpu",
        "component": "device",
        "sourceRef": "passthrough-gpu",
        "disposition": "refused",
        "restoreStrategy": "stop-before-restore",
        "refusalCode": "portable-vm-opaque-device-state-unsupported",
        "artifactRequirements": ["device-inventory", "stable-refusal-code"],
        "proofGate": "opaque-device-refusal-proof"
      },
      {
        "id": "vm/active-syscalls",
        "component": "kernel-state",
        "sourceRef": "active-syscalls",
        "disposition": "refused",
        "restoreStrategy": "stop-before-restore",
        "refusalCode": "portable-vm-active-syscall-unsupported",
        "artifactRequirements": ["syscall-detector-transcript", "stable-refusal-code"],
        "proofGate": "active-syscall-refusal-proof"
      }
    ]
  },
  "summary": {
    "manifestSections": 7,
    "planRows": 8,
    "portableRows": 1,
    "reconstructableRows": 1,
    "productSupportedRows": 2,
    "refusedRows": 4,
    "sameArchOnlyRows": 0,
    "unknownRows": 0,
    "publicClaimAllowed": false
  },
  "validationRules": [
    "Every manifest item must have a disposition.",
    "Every plan row with disposition=refused must have a stable refusalCode.",
    "Every product-supported row must name a proofGate and artifactRequirements.",
    "unknownStatePolicy=refuse-by-default must remain true for cross-architecture restore.",
    "A manifest/plan alone must not raise a public arbitrary VM restore claim."
  ]
}
