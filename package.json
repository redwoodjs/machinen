{
  "name": "machinen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "pretypecheck": "pnpm build",
    "typecheck": "tsgo --noEmit && pnpm run site:typecheck",
    "pretest": "pnpm build && cd packages/runtime/native && zig build",
    "test": "MACHINEN_RUNTIME_HELPER=$PWD/packages/runtime/native/zig-out/bin/machinen-runtime-helper MACHINEN_PDEATHSIG=$PWD/packages/runtime/native/zig-out/bin/machinen-pdeathsig MACHINEN_PTY=$PWD/packages/runtime/native/zig-out/bin/machinen-pty MACHINEN_WINSIZE=$PWD/packages/runtime/native/zig-out/bin/machinen-winsize vitest run --no-file-parallelism",
    "lint": "oxlint --deny-warnings && node scripts/fallow-health-guard.mjs && node scripts/runtime-native-boundary-check.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version": "changeset version && oxfmt",
    "release": "pnpm -F @machinen/runtime -F @machinen/cli build && changeset publish",
    "premachinen": "pnpm build",
    "machinen": "MACHINEN_ASSETS_DIR=${MACHINEN_ASSETS_DIR:-$PWD/release-assets} node packages/cli/dist/cli.js",
    "premn": "pnpm build",
    "mn": "MACHINEN_ASSETS_DIR=${MACHINEN_ASSETS_DIR:-$PWD/release-assets} node packages/cli/dist/cli.js",
    "build:docs": "typedoc && node scripts/build-api-toc.mjs",
    "dev": "bash scripts/dev.sh",
    "provision": "node provision.ts",
    "provision-test-vm": "node scripts/provision-test-vm.ts",
    "vm": "node vm.ts",
    "vm-pick": "bash scripts/vm-pick.sh",
    "repro-192": "node scripts/repro-issue-192.ts",
    "repro-954": "tsx scripts/repro-issue-954-persistent-pty.ts",
    "machinen-dev": "bash scripts/machinen-dev.sh",
    "smoke-tests": "bash scripts/smoke-tests.sh",
    "smoke-test-snapshot-restore-fork": "bash scripts/smoke-test-snapshot-restore-fork.sh",
    "check-smoke-manifest": "node scripts/check-smoke-manifest.mjs",
    "smoke-vmstate": "bash scripts/smoke/vmstate/all.sh",
    "smoke-vmstate-timers": "bash scripts/smoke/vmstate/timers.sh",
    "smoke-vmstate-entropy": "bash scripts/smoke/vmstate/entropy.sh",
    "smoke-vmstate-sockets": "bash scripts/smoke/vmstate/sockets.sh",
    "bench-net": "bash scripts/bench-net.sh",
    "bench-boot": "tsx scripts/bench-boot.ts",
    "bench": "tsx scripts/bench.ts",
    "validation:profile": "node scripts/validation-profile.mjs",
    "fallow:health": "node scripts/fallow-health-guard.mjs",
    "runtime-native-boundary-check": "node scripts/runtime-native-boundary-check.mjs",
    "site:build": "pnpm -F @machinen/marketing-website build",
    "site:typecheck": "pnpm -F @machinen/marketing-website types",
    "site:dev": "pnpm -F @machinen/marketing-website dev",
    "site:release": "pnpm -F @machinen/marketing-website release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@machinen/runtime": "workspace:*",
    "@nkzw/oxlint-config": "1.0.1",
    "@redwoodjs/agent-ci": "^0.15.0",
    "@types/node": "^22",
    "@typescript/native-preview": "^7.0.0-dev",
    "fallow": "^2.44.2",
    "oxfmt": "0.33.0",
    "oxlint": "1.48.0",
    "tsx": "^4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.7",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.30.3"
}
