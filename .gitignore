.DS_Store
node_modules/
.pnpm-store/
.devcontainer/kindling/
.machinen/
.machinen-vm/
.fallow/
dist/
release-assets/
.build-stage/
.kernel-build/
.claude/scheduled_tasks.lock
.claude/worktrees/

# vm-pick clonefile helper (built on first use; macOS-arm64 only)
scripts/clonefile
scripts/clonefile.o
scripts/clonefile.o.o
.zig-cache/

# Quickstart bake outputs and snapshot bundles. The example sources
# (bake.ts, counter.mjs) are tracked; everything `node bake.ts` and
# `mn-dev snapshot` produce is regenerable from those.
examples/quickstart/artifacts/
examples/quickstart/.claude/
counter-snap/

# Sidecar produced by scripts/build-vmm.sh next to the (also-untracked)
# locally-built VMM binary at packages/vmm-arm64-darwin/bin/machinen-vm.
packages/vmm-arm64-darwin/bin/machinen-vm.inputs-sha256

# gvproxy binary staged by scripts/install-gvproxy.sh next to the
# locally-built VMM for resolveGvproxyBinary()'s sibling lookup. CI
# stages it into the same path during release; only .gitkeep is tracked.
packages/vmm-arm64-darwin/bin/gvproxy
packages/vmm-arm64-linux/bin/gvproxy
