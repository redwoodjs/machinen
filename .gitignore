.DS_Store
node_modules/
.pnpm-store/
.devcontainer/kindling/
.machinen/
.machinen-vm/
.fallow/
dist/
release-assets/
release-assets-*/
.build-stage/
.kernel-build/
.claude/scheduled_tasks.lock
.claude/worktrees/

# vm-pick clonefile helper (built on first use; macOS-arm64 only)
scripts/clonefile
scripts/clonefile.o
scripts/clonefile.o.o
.zig-cache/
zig-out/

# Quickstart bake outputs and snapshot bundles. The example sources
# (bake.ts, counter.mjs) are tracked; everything `node bake.ts` and
# `mn-dev snapshot` produce is regenerable from those.
examples/quickstart/artifacts/
examples/quickstart/.claude/
counter-snap/

# fork-pi bake outputs + snapshot bundles. Same story as quickstart:
# bake.ts / run.ts are tracked, artifacts/ is regenerable.
examples/fork-pi/artifacts/
examples/fork-pi/.claude/

# Locally-built / CI-staged native binaries live inside the consolidated
# @machinen/native-arm64-{darwin,linux} packages. Each package's own
# .gitignore lists the staged binaries + sidecars; nothing extra needed
# at the repo root.

# build-vmm.sh / packaging staging dirs — VMM + gvproxy binaries only,
# no package source. Pure build output, never committed.
packages/vmm-arm64-darwin/
packages/vmm-arm64-linux/

# Validation profiler outputs.
.validation-runs/
