{
  "name": "Machinen",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "initializeCommand": "security find-generic-password -a $USER -w -s 'Claude Code-credentials' > ~/.claude/.credentials.json 2>/dev/null || true",

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y iputils-ping dnsutils net-tools && sudo npm install -g @anthropic-ai/claude-code && echo '{\"hasCompletedOnboarding\":true}' > /home/node/.claude.json && sudo corepack enable && pnpm install",

  "remoteUser": "node",

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  "mounts": [
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind",
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next"
      ]
    }
  }
}
