{
  "name": "@machinen/desktop-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Machinen Desktop's local socket API.",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/redwoodjs/machinen.git",
    "directory": "packages/desktop-sdk"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --root ../.. packages/desktop-sdk/src/__tests__",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
