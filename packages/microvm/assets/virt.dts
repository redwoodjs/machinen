/dts-v1/;

// Minimal arm64 "virt"-style device tree — trimmed for fast boot.
//
// What stays in is what the guest kernel + our VMM actually touch:
//   * the GIC v3 (interrupt controller — required)
//   * PL011 UART at 0x9000000 (console)
//   * twelve virtio-mmio slots at 0x0a000000+i*0x200:
//       0=net, 1=blk (rootdisk), 2=vsock, 3=blk2 (scratch),
//       4=balloon, 5=blk3 (mount lower / squashfs RO),
//       6=blk4 (mount upper / ext4 RW),
//       7..11=virtio-fs (#332 live mount, up to 5 per VM — #338)
//   * CPU, timer, psci, apb-pclk
//
// Slot 1 (blk) and slot 3 (blk2) carry the two virtio-blk devices:
// rootdisk on slot 1 (becomes /dev/vda) and scratch on slot 3
// (/dev/vdb when both are present). The runtime feeds them via
// MACHINEN_ROOTDISK and MACHINEN_DISK respectively. See #114.
//
// Slots 5 (blk3) and 6 (blk4) carry the `--mount` payload (#272):
// a content-addressed squashfs lower (RO) and a per-VM ext4 upper
// (RW), layered into a single overlayfs at /mnt/<guest>/ by /init.
// They become /dev/vdc and /dev/vdd in DTB order when rootdisk +
// scratch are both populated. The runtime feeds them via
// MACHINEN_MOUNTDISK_LOWER_FD and MACHINEN_MOUNTDISK_UPPER_FD —
// fd-passed, never path-passed, so the host source dir is never
// consulted by the guest at runtime.
//
// Nodes we *used* to carry via the QEMU virt reference DTS and have
// now dropped for sub-second-spawn work (#50): `pcie`, `pl031` rtc,
// `pmu`, `flash`, `fw-cfg`, `platform-bus`, `gpio-keys`/`pl061`, the
// GIC ITS, and 28 unused virtio_mmio slots. Each of these made the
// kernel spend time probing things we never use.

/ {
	interrupt-parent = <0x8002>;
	dma-coherent;
	model = "linux,machinen-virt";
	#size-cells = <0x02>;
	#address-cells = <0x02>;
	compatible = "linux,dummy-virt";

	psci {
		migrate = <0xc4000005>;
		cpu_on = <0xc4000003>;
		cpu_off = <0x84000002>;
		cpu_suspend = <0xc4000001>;
		method = "hvc";
		compatible = "arm,psci-1.0", "arm,psci-0.2", "arm,psci";
	};

	memory@40000000 {
		reg = <0x00 0x40000000 0x01 0x00000000>;
		device_type = "memory";
	};

	virtio_mmio@a000000 {
		dma-coherent;
		interrupts = <0x00 0x10 0x01>;
		reg = <0x00 0xa000000 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a000200 {
		dma-coherent;
		interrupts = <0x00 0x11 0x01>;
		reg = <0x00 0xa000200 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a000400 {
		dma-coherent;
		interrupts = <0x00 0x12 0x01>;
		reg = <0x00 0xa000400 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a000600 {
		dma-coherent;
		interrupts = <0x00 0x13 0x01>;
		reg = <0x00 0xa000600 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	// #263 phase B: slot 4 carries virtio-balloon. The driver posts
	// free-page batches on the page-reporting virtqueue; the host
	// madvises(MADV_DONTNEED) the corresponding range so RSS shrinks
	// alongside guest free memory.
	virtio_mmio@a000800 {
		dma-coherent;
		interrupts = <0x00 0x14 0x01>;
		reg = <0x00 0xa000800 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	// #272: slot 5 carries the squashfs RO lower for the `--mount`
	// payload. The runtime fd-passes the content-addressed cache
	// file via MACHINEN_MOUNTDISK_LOWER_FD; /init mounts the
	// resulting /dev/vdc read-only at a pre-pivot path.
	virtio_mmio@a000a00 {
		dma-coherent;
		interrupts = <0x00 0x15 0x01>;
		reg = <0x00 0xa000a00 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	// #272: slot 6 carries the ext4 RW upper for the `--mount`
	// overlay. Per-VM sparse file fd-passed via
	// MACHINEN_MOUNTDISK_UPPER_FD; /init mounts /dev/vdd with
	// `discard` so deletes auto-reclaim host disk via virtio-blk
	// VIRTIO_BLK_F_DISCARD → fallocate(PUNCH_HOLE).
	virtio_mmio@a000c00 {
		dma-coherent;
		interrupts = <0x00 0x16 0x01>;
		reg = <0x00 0xa000c00 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	// #332/#338: slots 7..11 carry up to five virtio-fs devices, one
	// per `--mount-live` (and one is consumed internally by a
	// `restore({ lazy: true })` to serve the page image). Each in-VMM
	// device serves a host directory over a FUSE-derived virtqueue
	// protocol; /init mounts it with `mount -t virtiofs <tag> <guest>`.
	// Replaces the FUSE-over-vsock transport — no vsock framing, no
	// guest fuse-agent byte-pump. A slot is empty when the runtime
	// didn't request that many live mounts.
	virtio_mmio@a000e00 {
		dma-coherent;
		interrupts = <0x00 0x17 0x01>;
		reg = <0x00 0xa000e00 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a001000 {
		dma-coherent;
		interrupts = <0x00 0x18 0x01>;
		reg = <0x00 0xa001000 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a001200 {
		dma-coherent;
		interrupts = <0x00 0x19 0x01>;
		reg = <0x00 0xa001200 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a001400 {
		dma-coherent;
		interrupts = <0x00 0x1a 0x01>;
		reg = <0x00 0xa001400 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	virtio_mmio@a001600 {
		dma-coherent;
		interrupts = <0x00 0x1b 0x01>;
		reg = <0x00 0xa001600 0x00 0x200>;
		compatible = "virtio,mmio";
	};

	pl011@9000000 {
		current-speed = <0x1c200>;  // 115200
		clock-names = "uartclk", "apb_pclk";
		clocks = <0x8000 0x8000>;
		interrupts = <0x00 0x01 0x04>;
		reg = <0x00 0x9000000 0x00 0x1000>;
		compatible = "arm,sbsa-uart";
	};

	intc@8000000 {
		phandle = <0x8002>;
		reg = <0x00 0x8000000 0x00 0x10000 0x00 0x10000000 0x00 0x2000000>;
		#redistributor-regions = <0x01>;
		compatible = "arm,gic-v3";
		ranges;
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		interrupt-controller;
		#interrupt-cells = <0x03>;
	};

	cpus {
		#size-cells = <0x00>;
		#address-cells = <0x01>;

		cpu-map {
			socket0 {
				cluster0 {
					core0 {
						cpu = <0x8001>;
					};
				};
			};
		};

		cpu@0 {
			phandle = <0x8001>;
			reg = <0x00>;
			compatible = "arm,cortex-a72";
			device_type = "cpu";
		};
	};

	timer {
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
		always-on;
		compatible = "arm,armv8-timer", "arm,armv7-timer";
	};

	apb-pclk {
		phandle = <0x8000>;
		clock-output-names = "clk24mhz";
		clock-frequency = <0x16e3600>;
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
	};

	aliases {
		serial0 = "/pl011@9000000";
	};

	chosen {
		bootargs = "earlycon=pl011,mmio32,0x9000000 console=ttyAMA0 panic=1 loglevel=3 quiet arm64.nopauth";
		linux,initrd-start = <0x44000000>;
		// End of the initrd reserved region. The kernel scans the whole
		// window looking for concatenated cpio archives; leaving this
		// too generous costs real wall-clock during early boot (#50
		// sub-second spawn). Sized to fit the current full rootfs cpio
		// (~884 MB) with slack. TODO: patch at runtime from the actual
		// loaded initrd length so slim cpios get the full win.
		linux,initrd-end = <0x84000000>;
		stdout-path = "/pl011@9000000";
		rng-seed = <0x1a11afe9 0x8fd8244a 0xab34bc9d 0x722c6957 0xd0b2f2e0 0x82d58105 0x88b74715 0x107ef8a1>;
		kaslr-seed = <0xdb4642f7 0x8a825170>;
	};
};
