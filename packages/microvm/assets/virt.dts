			compatible = "arm,cortex-a72";
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10 {
			phandle = <0x8110>;
			reg = <0x10>;
			compatible = "arm,cortex-a72";
			device_type = "cpu";
			enable-method = "psci";
