FROM node:lts-slim
# CRIU needs netlink-related kernel modules loaded at runtime
# (sock_diag, netlink_diag, unix_diag). The Debian cloud kernel
# ships them as modules in /lib/modules/, so pull in the
# linux-image-cloud-arm64 package purely for those modules.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        criu \
        kmod \
        ca-certificates \
        linux-image-cloud-arm64 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
