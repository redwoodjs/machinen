# Exclude list for the #50 spawn latency path.
#
# Patterns are fnmatch-style, matched against each entry's rootfs-
# relative path during the walk in mkinitramfs.ts. A match prunes the
# entry (and, for directories, the whole subtree).
#
# The target scenario is spawn-warmup.sh + spawn-restore.sh: format
# /dev/vda, run a Node counter, CRIU dump + restore. Everything
# Claude-Code, npm, yarn, udev, and most kernel driver/fs/net modules
# are dead weight for that flow.
#
# Non-spawn smoke modes (repl, criu, net, cc-*) still use the full
# rootfs — smoke.sh only passes this file for `spawn`.

# === Claude Code / JS ecosystem ===
usr/local/lib/node_modules/@anthropic-ai
usr/local/lib/node_modules/npm
usr/local/lib/node_modules/corepack
usr/local/bin/claude
usr/local/bin/npm
usr/local/bin/npx
usr/local/bin/corepack
usr/local/bin/yarn
usr/local/bin/yarnpkg
usr/local/bin/docker-entrypoint.sh
usr/local/bin/nodejs
usr/local/CHANGELOG.md
usr/local/README.md
usr/local/LICENSE
usr/local/include
opt/yarn-v1.22.22

# === Duplicate kernel artefacts ===
# VMM passes Image directly via MACHINEN_KERNEL; /boot is dead weight.
boot

# === Subsystems we don't run ===
usr/lib/udev
usr/lib/systemd
etc/systemd
etc/udev

# === Unused kernel module subtrees ===
# Keep drivers/virtio, drivers/block (virtio_blk), drivers/net (tun, veth),
# lib (libcrc32c), net (netlink, unix, ipv4, packet, netfilter diagnostics
# and nf_tables), and fs/ext4.
usr/lib/modules/*/kernel/drivers/infiniband
usr/lib/modules/*/kernel/drivers/md
usr/lib/modules/*/kernel/drivers/scsi
usr/lib/modules/*/kernel/drivers/target
usr/lib/modules/*/kernel/drivers/ata
