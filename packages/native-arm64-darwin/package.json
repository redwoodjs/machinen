{
  "name": "@machinen/native-arm64-darwin",
  "version": "0.7.0",
  "description": "Machinen host-side native binaries for arm64 darwin — VMM (HVF) + gvproxy + guest ELFs, mke2fs, and mksquashfs. Consolidates what used to be several per-tool packages.",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/redwoodjs/machinen.git",
    "directory": "packages/native-arm64-darwin"
  },
  "bin": {
    "machinen-gvproxy": "./vmm/bin/gvproxy",
    "machinen-mke2fs": "./e2fsprogs/bin/mke2fs",
    "machinen-mksquashfs": "./squashfs/bin/mksquashfs",
    "machinen-pdeathsig": "./vmm/bin/machinen-pdeathsig",
    "machinen-pty": "./vmm/bin/machinen-pty",
    "machinen-runtime-helper": "./vmm/bin/machinen-runtime-helper",
    "machinen-vm": "./vmm/bin/machinen-vm",
    "machinen-winsize": "./vmm/bin/machinen-winsize"
  },
  "files": [
    "vmm/bin/",
    "vmm/guest/",
    "e2fsprogs/bin/",
    "e2fsprogs/lib/",
    "squashfs/bin/",
    "squashfs/lib/",
    "index.mjs"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "type": "module",
  "main": "./index.mjs"
}
