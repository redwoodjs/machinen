{
  "name": "@machinen/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "machinen": "./dist/machinen.js"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/machinen.js",
    "typecheck": "tsgo --noEmit",
    "dev:local": "MACHINEN_REGISTRY=localhost:5001 node dist/machinen.js",
    "dev:remote": "node dist/machinen.js"
  },
  "dependencies": {
    "@machine/sdk": "workspace:*"
  }
}
