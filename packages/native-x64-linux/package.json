{
  "name": "@machinen/native-x64-linux",
  "version": "0.8.7",
  "description": "Machinen host-side native binaries for amd64 Linux — VMM (KVM) + gvproxy + guest ELFs, mke2fs, and mksquashfs.",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/redwoodjs/machinen.git",
    "directory": "packages/native-x64-linux"
  },
  "bin": {
    "machinen-gvproxy": "./vmm/bin/gvproxy",
    "machinen-mke2fs": "./e2fsprogs/bin/mke2fs",
    "machinen-mksquashfs": "./squashfs/bin/mksquashfs",
    "machinen-pdeathsig": "./vmm/bin/machinen-pdeathsig",
    "machinen-pty": "./vmm/bin/machinen-pty",
    "machinen-runtime-helper": "./vmm/bin/machinen-runtime-helper",
    "machinen-vm": "./vmm/bin/machinen-vm",
    "machinen-winsize": "./vmm/bin/machinen-winsize"
  },
  "files": [
    "index.mjs",
    "vmm/bin/",
    "vmm/guest/",
    "e2fsprogs/bin/",
    "squashfs/bin/",
    "README.md"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  }
}
